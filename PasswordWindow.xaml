<Window x:Class="ImageForge.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secret gallery" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" Foreground="{DynamicResource Ink}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- the Input look, for passwords -->
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="{DynamicResource Field}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,0,40,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="PasswordBox">
            <Border x:Name="B" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource LineStrong}"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Shown" TargetType="TextBox" BasedOn="{StaticResource Input}">
      <Setter Property="Height" Value="38"/>
      <Setter Property="Padding" Value="10,0,40,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Visibility" Value="Collapsed"/>
    </Style>
  </Window.Resources>

  <Border Margin="24" CornerRadius="14" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineStrong}" BorderThickness="1"
          Padding="28,26,28,24" MouseLeftButtonDown="Card_MouseDown">
    <Border.Effect><DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5"/></Border.Effect>
    <StackPanel>
      <Border Width="52" Height="52" CornerRadius="26" Background="#26F0A04B" HorizontalAlignment="Center">
        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="22" Foreground="{DynamicResource Accent}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
      <TextBlock x:Name="SubText" Style="{StaticResource Note}" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>

      <TextBlock Text="Password" Style="{StaticResource Heading}" Margin="0,22,0,6"/>
      <Grid>
        <PasswordBox x:Name="First" AutomationProperties.Name="Password"/>
        <TextBox x:Name="FirstShown" Style="{StaticResource Shown}" AutomationProperties.Name="Password"/>
        <Button x:Name="RevealBtn" Style="{StaticResource IconBtn}" Content="&#xE890;" FontSize="14" Width="30" Height="30" HorizontalAlignment="Right"
                Margin="0,0,4,0" Focusable="False" Click="Reveal_Click" ToolTip="Show password" AutomationProperties.Name="Show password"/>
      </Grid>
      <StackPanel x:Name="AgainPanel">
        <TextBlock Text="Type it again" Style="{StaticResource Heading}" Margin="0,14,0,6"/>
        <PasswordBox x:Name="Again" AutomationProperties.Name="Type the password again"/>
        <TextBox x:Name="AgainShown" Style="{StaticResource Shown}" AutomationProperties.Name="Type the password again"/>
      </StackPanel>

      <StackPanel x:Name="CapsNote" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
        <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
        <TextBlock Text="Caps Lock is on" FontSize="12" Foreground="{DynamicResource Accent}"/>
      </StackPanel>
      <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" FontSize="12.5" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

      <Border x:Name="Warning" CornerRadius="8" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="12,10" Margin="0,16,0,0">
        <DockPanel>
          <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Accent}" Margin="0,1,10,0" VerticalAlignment="Top"/>
          <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource Soft}"
                     Text="There's no reset. If you forget this password, the pictures you hide can't be opened again."/>
        </DockPanel>
      </Border>

      <Grid x:Name="Buttons" Margin="0,22,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition Width="10"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource Ghost}" Height="40" Content="Cancel" IsCancel="True"/>
        <Button x:Name="OkBtn" Grid.Column="2" Style="{StaticResource Primary}" Height="40" IsDefault="True" Click="Ok_Click"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
